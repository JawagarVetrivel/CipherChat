# CipherChat Backend Environment Configuration

# Server Port (Render sets this dynamically)
PORT=3001

# Environment
NODE_ENV=development

# Frontend URL for CORS configuration (e.g. Vercel deployment URL or localhost)
FRONTEND_URL=http://localhost:3000

# Supabase PostgreSQL Configuration
# Found in your Supabase project settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
# IMPORTANT: Service Role Key has administrative privileges - NEVER expose to frontend
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# JWT Secret for session tokens and WebSocket authentication
JWT_SECRET=your_super_secret_jwt_signing_key_change_in_production
JWT_EXPIRES_IN=7d

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
